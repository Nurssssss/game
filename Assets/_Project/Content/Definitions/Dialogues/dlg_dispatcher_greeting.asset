  - choiceId: choice_polite_kazakh
    line:
      russian: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
        \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435"
      kazakh: "\u0421\u04D9\u043B\u0435\u043C\u0435\u0442\u0441\u0456\u0437 \u0431\u0435!
