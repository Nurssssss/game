    - word_salem
    - word_zhumys
  choices:
  - choiceId: choice_yes
    line:
      russian: "\u0414\u0430, \u044F \u0433\u043E\u0442\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C"
      kazakh: "\u0418\u04D9, \u0436\u04B1\u043C\u044B\u0441\u049B\u0430 \u0434\u0430\u0439\u044B\u043D\u043C\u044B\u043D"
