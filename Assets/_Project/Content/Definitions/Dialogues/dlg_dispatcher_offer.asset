  speakerNpcId: npc_dispatcher
  line:
    russian: "\u0417\u0430\u0431\u0435\u0440\u0438 \u043F\u043E\u0441\u044B\u043B\u043A\u0443
      \u0437\u0434\u0435\u0441\u044C \u0438 \u043E\u0442\u043D\u0435\u0441\u0438
      \u0432 \u043A\u0430\u0444\u0435. \u041E\u043F\u043B\u0430\u0442\u0430 \u043F\u043E\u0441\u043B\u0435
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438."
    kazakh: "\u0421\u04D9\u043B\u0435\u043C\u0434\u0435\u043C\u0435\u043D\u0456 \u043E\u0441\u044B
      \u0436\u0435\u0440\u0434\u0435\u043D \u0430\u043B\u044B\u043F, \u0434\u04D9\u043C\u0445\u0430\u043D\u0430\u0493\u0430
      \u0436\u0435\u0442\u043A\u0456\u0437. \u0410\u049B\u044B \u0436\u0435\u0442\u043A\u0456\u0437\u0443\u0434\u0435\u043D
      \u043A\u0435\u0439\u0456\u043D."
